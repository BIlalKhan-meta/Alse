+
+#pragma once
+
+namespace margelo::nitro {
+class HybridObject;
+} // namespace margelo::nitro
+
+#include "IsSharedPtrTo.hpp"
+#include "NitroDefines.hpp"
+#include "NitroTypeInfo.hpp"
