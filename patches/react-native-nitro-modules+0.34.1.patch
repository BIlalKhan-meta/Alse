+
+// NullType <> null
+template <>
+struct JSIConverter<NullType> final {
+  static inline NullType fromJSI(jsi::Runtime&, const jsi::Value& arg) {
+    if (!arg.isNull()) [[unlikely]] {
+      throw std::runtime_error("Cannot convert non-null value to NullType!");
