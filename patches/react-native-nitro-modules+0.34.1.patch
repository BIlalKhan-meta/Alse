+  void reject(jni::alias_ref<jni::JThrowable> error) {
+    std::unique_lock lock(_mutex);
+    jni::global_ref<jni::JThrowable> globalError = jni::make_global(error);
+    _state = globalError;
+    for (const auto& onRejected : _onRejectedListeners) {
+      onRejected(error);
