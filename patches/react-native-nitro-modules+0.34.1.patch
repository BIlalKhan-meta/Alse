+//
+//  JSICache.hpp
+//  NitroModules
+//
+//  Created by Marc Rousavy on 20.06.24.
+//
+
+#pragma once
+
+#include "BorrowingReference.hpp"
+#include "NitroLogger.hpp"
+#include "WeakReference.hpp"
+#include <jsi/jsi.h>
+#include <memory>
+#include <mutex>
