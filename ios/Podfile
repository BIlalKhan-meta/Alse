def node_require(script)
  # Resolve script with node to allow for hoisting
  require Pod::Executable.execute_command('node', ['-p',
    "require.resolve(
      '#{script}',
      {paths: [process.argv[1]]},
    )", __dir__]).strip
end

node_require('react-native/scripts/react_native_pods.rb')
node_require('react-native-permissions/scripts/setup.rb')

platform :ios, '16.0'
prepare_react_native_project!

# Reduce flaky large-repo git clone failures during pod install.
ENV['GIT_HTTP_VERSION'] = 'HTTP/1.1'
ENV['GIT_CONFIG_COUNT'] = '2'
ENV['GIT_CONFIG_KEY_0'] = 'http.version'
ENV['GIT_CONFIG_VALUE_0'] = 'HTTP/1.1'
ENV['GIT_CONFIG_KEY_1'] = 'http.postBuffer'
ENV['GIT_CONFIG_VALUE_1'] = '524288000'

# BoringSSL-GRPC clones a very large git repo and often fails over HTTP/2.
# Use the vendored checkout prepared by scripts/vendor-boringssl-grpc.sh.
BORINGSSL_GRPC_VENDOR = File.join(__dir__, 'vendor/boringssl-grpc')
unless File.directory?(File.join(BORINGSSL_GRPC_VENDOR, '.git'))
  vendor_script = File.join(__dir__, 'scripts/vendor-boringssl-grpc.sh')
  success = system(vendor_script)
  unless success && File.directory?(BORINGSSL_GRPC_VENDOR)
    raise <<~ERROR
      Missing #{BORINGSSL_GRPC_VENDOR}.
      Run: ./scripts/vendor-boringssl-grpc.sh
    ERROR
  end
end

setup_permissions([
  'Camera',
  'Microphone',
  'Notifications',
  'PhotoLibrary',
])

# Remove this block or use it consistently
# linkage = ENV['USE_FRAMEWORKS']
# if linkage != nil
#   Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
#   use_frameworks! :linkage => linkage.to_sym
# end

target 'Alenga' do
  config = use_native_modules!

  # Keep only ONE use_frameworks! declaration
  use_frameworks! :linkage => :static
  $RNFirebaseAsStaticFramework = true

  # pod 'ZoomVideoSDK'

  pod 'BoringSSL-GRPC', :git => BORINGSSL_GRPC_VENDOR

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    # Add Hermes configuration explicitly
    :hermes_enabled => true
  )

  # Remove this - react-native-svg should be auto-linked
  # pod 'RNSVG', :path => '../node_modules/react-native-svg'

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    def apple_silicon_mac?
      arm64_hw = `sysctl -n hw.optional.arm64 2>/dev/null`.strip
      return true if arm64_hw == '1'

      cpu_type = `sysctl -n hw.cputype 2>/dev/null`.strip
      return true if cpu_type == '16777228'

      `uname -m`.strip == 'arm64'
    end

    simulator_excluded_archs = 'i386 x86_64'
    grpc_targets = ['gRPC-Core', 'gRPC-C++', 'abseil', 'BoringSSL-GRPC']
    folly_defs = [
      'FOLLY_NO_CONFIG',
      'FOLLY_MOBILE=1',
      'FOLLY_USE_LIBCPP=1',
      'FOLLY_CFG_NO_COROUTINES=1',
      'FOLLY_HAVE_CLOCK_GETTIME=1',
    ]
    folly_module_targets = ['React-jsi', 'RCT-Folly', 'NitroModules', 'NitroMediaKit']
    folly_cpp_flags = '-DFOLLY_NO_CONFIG -DFOLLY_MOBILE=1 -DFOLLY_USE_LIBCPP=1 -DFOLLY_CFG_NO_COROUTINES=1 -DFOLLY_HAVE_CLOCK_GETTIME=1'
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        if folly_module_targets.include?(target.name)
          defs = config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] || '$(inherited)'
          defs = [defs] if defs.is_a?(String)
          folly_defs.each do |definition|
            key = definition.split('=').first
            unless defs.any? { |entry| entry.to_s.include?(key) }
              defs << definition
            end
          end
          config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = defs

          %w[OTHER_CFLAGS OTHER_CPLUSPLUSFLAGS].each do |flag_setting|
            flags = config.build_settings[flag_setting] || '$(inherited)'
            flags = flags.join(' ') if flags.is_a?(Array)
            unless flags.include?('FOLLY_NO_CONFIG')
              config.build_settings[flag_setting] = "#{flags} #{folly_cpp_flags}"
            end
          end
        end
        # Exclude Android-specific headers from iOS builds
        ['HEADER_SEARCH_PATHS', 'USER_HEADER_SEARCH_PATHS'].each do |setting|
          if config.build_settings[setting]
            paths = config.build_settings[setting]
            if paths.is_a?(Array)
              config.build_settings[setting] = paths.reject do |path|
                path.is_a?(String) && (path.include?('platform/android') || path.include?('/android/'))
              end
            elsif paths.is_a?(String)
              # Handle space-separated paths
              filtered_paths = paths.split(' ').reject do |path|
                path.include?('platform/android') || path.include?('/android/')
              end
              config.build_settings[setting] = filtered_paths.join(' ')
            end
          end
        end
        
        # Exclude Android paths from other compiler flags
        ['OTHER_CFLAGS', 'OTHER_CPLUSPLUSFLAGS'].each do |setting|
          if config.build_settings[setting]
            flags = config.build_settings[setting]
            if flags.is_a?(Array)
              config.build_settings[setting] = flags.reject do |flag|
                flag.is_a?(String) && (flag.include?('platform/android') || flag.include?('/android/'))
              end
            end
          end
        end
        
        # Fix RCTProfileTrampoline: exclude wrong-architecture assembly when building for device (arm64)
        if target.name == 'React-Core'
          config.build_settings['EXCLUDED_SOURCE_FILE_NAMES[sdk=iphoneos*]'] = 'RCTProfileTrampoline-x86_64.S RCTProfileTrampoline-i386.S'
          config.build_settings['EXCLUDED_SOURCE_FILE_NAMES[sdk=iphonesimulator*]'] = 'RCTProfileTrampoline-arm.S'
        end

        config.build_settings['ENABLE_BITCODE'] = 'NO'
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'

        if config.name == 'Debug'
          config.build_settings['ONLY_ACTIVE_ARCH'] = 'YES'
        end

        if apple_silicon_mac?
          config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = simulator_excluded_archs
        end

        if grpc_targets.include?(target.name)
          config.build_settings['COMPILER_INDEX_STORE_ENABLE'] = 'NO'
          if config.name == 'Debug'
            config.build_settings['GCC_OPTIMIZATION_LEVEL'] = '0'
          end
        end
      end
      
      # Remove Android header files from the target's file references (only for native targets)
      if target.respond_to?(:source_build_phase) && target.source_build_phase
        target.source_build_phase.files.each do |file|
          if file.file_ref && file.file_ref.path && file.file_ref.path.include?('platform/android')
            file.remove_from_project
          end
        end
      end
    end

    installer.pods_project.build_configurations.each do |config|
      if apple_silicon_mac?
        config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = simulator_excluded_archs
      end
    end

    installer.aggregate_targets.each do |aggregate_target|
      aggregate_target.xcconfigs.each do |config_name, config_file|
        if apple_silicon_mac?
          config_file.attributes['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = simulator_excluded_archs
        end
        aggregate_target.xcconfig_path(config_name).tap do |xcconfig_path|
          config_file.save_as(xcconfig_path)
        end
      end
    end

    flt_defs = [
      'FLT_MAX=3.40282346638528859811704183484516925e+38F',
      'FLT_MIN=1.17549435082228750796873653722224568e-38F',
    ]

    # Fix FLT_MAX/FLT_MIN for main app target (UIKit/UIStackView.h in iOS 18.5+ SDK)
    installer.aggregate_targets.each do |aggregate_target|
      aggregate_target.user_project.targets.each do |target|
        if target.name == 'Alenga'
          target.build_configurations.each do |config|
            config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'

            defs = config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] || '$(inherited)'
            defs = [defs] if defs.is_a?(String)
            unless flt_defs.all? { |d| defs.any? { |f| f.to_s.include?(d.split('=').first) } }
              config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = defs + flt_defs
            end

            if apple_silicon_mac?
              config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = simulator_excluded_archs
            end

            if config.name == 'Debug'
              config.build_settings['ONLY_ACTIVE_ARCH'] = 'YES'
            end
          end
        end
      end
      aggregate_target.user_project.build_configurations.each do |config|
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
        if apple_silicon_mac?
          config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = simulator_excluded_archs
        end
      end
      aggregate_target.user_project.save
    end

    installer.pods_project.save

    # Agora RTM may ship bitcode; strip for App Store validation (LetsPlanADate pattern)
    bitcode_strip_path = `xcrun --find bitcode_strip`.chop!
    def strip_agora_rtm_bitcode(bitcode_strip_path, framework_path)
      return unless File.exist?(framework_path)
      system("#{bitcode_strip_path} #{framework_path} -r -o #{framework_path}")
    end
    pods_root = installer.sandbox.root
    strip_agora_rtm_bitcode(
      bitcode_strip_path,
      File.join(pods_root, 'AgoraRtm_iOS/AgoraRtmKit.xcframework/ios-arm64_armv7/AgoraRtmKit.framework/AgoraRtmKit'),
    )

  end
end